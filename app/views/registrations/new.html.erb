<% content_for :title, "新規登録 – RewardMe" %>

<div class="grid min-h-[80vh] place-items-center">
  <div class="w-full max-w-sm rounded-card border border-hairline bg-surface bg-linear-to-b from-white/[0.035] to-transparent px-6 py-7 shadow-card">
    <div class="flex items-center gap-2.5">
      <span aria-hidden="true" class="text-2xl leading-none drop-shadow-[0_0_10px_rgba(255,142,196,0.5)]">🎀</span>
      <p class="bg-linear-to-r from-[#ffb3d9] to-[#ff7ab8] bg-clip-text text-xl font-extrabold tracking-wide text-transparent">RewardMe</p>
    </div>

    <h1 class="mt-5 text-lg font-bold">新規登録</h1>
    <p class="mt-1 text-xs text-ink-faint">リボンちゃんとの暮らしをはじめましょう。</p>

    <%= form_with model: @user, url: registration_path, class: "mt-6 grid gap-5" do |form| %>
      <div>
        <%= form.label :email_address, "メールアドレス", class: "block text-xs font-bold text-ink-muted" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              class: "mt-2 block w-full rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-pink focus:outline-none" %>
        <%# 属性ごとにメッセージを出す。full_messages だと属性名が前置され、
            「このメールアドレスは既に登録されています」がそのまま出せないため。 %>
        <% @user.errors[:email_address].each do |message| %>
          <p class="mt-1.5 text-xs text-danger"><%= message %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password, "パスワード", class: "block text-xs font-bold text-ink-muted" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72,
              class: "mt-2 block w-full rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-pink focus:outline-none" %>
        <p class="mt-1.5 text-xs text-ink-faint">6文字以上</p>
        <% @user.errors[:password].each do |message| %>
          <p class="mt-1.5 text-xs text-danger"><%= message %></p>
        <% end %>
      </div>

      <div>
        <%= form.label :password_confirmation, "パスワード（確認）", class: "block text-xs font-bold text-ink-muted" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72,
              class: "mt-2 block w-full rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-pink focus:outline-none" %>
        <% @user.errors[:password_confirmation].each do |message| %>
          <p class="mt-1.5 text-xs text-danger"><%= message %></p>
        <% end %>
      </div>

      <%= form.submit "登録する", class: "w-full cursor-pointer rounded-item bg-brand-pink px-4 py-2.5 text-sm font-bold text-app-bg" %>
    <% end %>

    <p class="mt-6 text-xs text-ink-muted">
      すでにアカウントをお持ちですか？
      <%= link_to "ログイン", new_session_path, class: "font-bold text-brand-pink underline hover:no-underline" %>
    </p>
  </div>
</div>
