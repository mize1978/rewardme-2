<% content_for :title, "ログイン – RewardMe" %>

<div class="grid min-h-[80vh] place-items-center">
  <div class="w-full max-w-sm rounded-card border border-hairline bg-surface bg-linear-to-b from-white/[0.035] to-transparent px-6 py-7 shadow-card">
    <div class="flex items-center gap-2.5">
      <span aria-hidden="true" class="text-2xl leading-none drop-shadow-[0_0_10px_rgba(255,142,196,0.5)]">🎀</span>
      <p class="bg-linear-to-r from-[#ffb3d9] to-[#ff7ab8] bg-clip-text text-xl font-extrabold tracking-wide text-transparent">RewardMe</p>
    </div>

    <h1 class="mt-5 text-lg font-bold">ログイン</h1>

    <%# SessionsController は失敗時に redirect + flash で戻すため、ここで flash を表示する。 %>
    <% if flash[:alert] %>
      <p role="alert" class="mt-4 rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-xs text-danger"><%= flash[:alert] %></p>
    <% end %>
    <% if flash[:notice] %>
      <p role="status" class="mt-4 rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-xs text-ink-muted"><%= flash[:notice] %></p>
    <% end %>

    <%= form_with url: session_path, class: "mt-6 grid gap-5" do |form| %>
      <div>
        <%= form.label :email_address, "メールアドレス", class: "block text-xs font-bold text-ink-muted" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address],
              class: "mt-2 block w-full rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-pink focus:outline-none" %>
      </div>

      <div>
        <%= form.label :password, "パスワード", class: "block text-xs font-bold text-ink-muted" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "mt-2 block w-full rounded-item border border-hairline bg-white/[0.03] px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-faint focus:border-brand-pink focus:outline-none" %>
      </div>

      <%= form.submit "ログイン", class: "w-full cursor-pointer rounded-item bg-brand-pink px-4 py-2.5 text-sm font-bold text-app-bg" %>
    <% end %>

    <p class="mt-6 text-xs text-ink-muted">
      アカウントをお持ちでないですか？
      <%= link_to "新規登録", new_registration_path, class: "font-bold text-brand-pink underline hover:no-underline" %>
    </p>
  </div>
</div>
